# Static files only. Railway terminates HTTPS and passes plain HTTP to $PORT.
{
	admin off
	auto_https off
	# A connection that has not sent its request headers within 10 seconds is closed.
	servers {
		timeouts {
			read_header 10s
		}
	}
}

# The security headers, for every response: the pages and the page for a wrong address.
(security) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		# Scripts and assets from this site only. Inline styles stay allowed: the pages use
		# two style attributes and each report.html carries its own <style> block.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	import security
	# The free check reads a file inside the page: it may connect to nothing, not even this
	# site. ">" sets the policy when the response is written, after the site's own above.
	@check path /check /check.html
	header @check >Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	# The example reports are judgekeeper's own report.html: one inline script (Show all, Copy)
	# and fonts inside the file. Only under /examples/ may a page run them. 'unsafe-inline' stays:
	# a browser applies this policy and the page's own together, and each report's meta policy
	# names its script by hash, so only that script runs. scripts/build_pages.py stops on an
	# example page that has a script but not that meta policy.
	@examples path /examples/*
	header @examples >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	# Old addresses go to the page that has their content now.
	redir /setup /start#keys 301
	redir /setup.html /start#keys 301
	redir /assistant /start 301
	redir /assistant.html /start 301
	redir /own-metric /start#own-format 301
	redir /own-metric.html /start#own-format 301
	redir /tutorial /start 301
	redir /tutorial.html /start 301
	redir /guide /start 301
	redir /guide.html /start 301
	# /start finds start.html.
	try_files {path} {path}.html
	file_server

	# A wrong address gets the site's own page, with its 404 status. Its links start at the
	# root, so it works at any depth.
	handle_errors 404 {
		import security
		rewrite * /errors/404.html
		file_server
	}
	# Any other error (400 for a bad address, 405 for a POST) keeps the same headers, with no
	# Server header, and an empty body.
	handle_errors {
		import security
	}
}
